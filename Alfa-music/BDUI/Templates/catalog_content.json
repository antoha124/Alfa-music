{
  "root": {
    "id": "catalog_root",
    "type": "scroll",
    "content": {
      "spacing": "m",
      "padding": "m",
      "backgroundColor": "background"
    },
    "subviews": [
      {
        "id": "catalog_header_stack",
        "type": "vStack",
        "content": {
          "spacing": "xs"
        },
        "subviews": [
          {
            "id": "catalog_title",
            "type": "label",
            "content": {
              "text": "Каталог",
              "textStyle": "titleLarge",
              "color": "textPrimary",
              "alignment": "left",
              "numberOfLines": 0
            }
          },
          {
            "id": "catalog_subtitle",
            "type": "label",
            "content": {
              "text": "Найдено: {{itemsCount}}",
              "textStyle": "captionSecondary",
              "color": "textSecondary",
              "alignment": "left",
              "numberOfLines": 0
            }
          }
        ]
      },
      {
        "id": "catalog_items_stack",
        "type": "vStack",
        "content": {
          "spacing": "m"
        },
        "subviews": "{{albumNodes}}"
      },
      {
        "id": "catalog_load_more",
        "type": "button",
        "content": {
          "title": "Загрузить еще",
          "style": "secondary",
          "isEnabled": true
        },
        "action": {
          "type": "event",
          "name": "paginate"
        }
      }
    ]
  }
}
